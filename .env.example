# Optional settings of this copy. Copy this file to .env and uncomment what you want to change;
# without a .env the defaults below apply. WHERE_TO_GO_PORT, WHERE_TO_GO_DATA_DIR and
# WHERE_TO_GO_INSTANCE in the environment override .env.

# The app opens at http://127.0.0.1:<PORT>.
# PORT=48765

# Folder for the database and images; a relative path is inside this copy. Empty: the user data folder
# of the platform (~/Library/Application Support/where-to-go on macOS, ~/.local/share/where-to-go on
# Linux, %LOCALAPPDATA%\where-to-go on Windows). A git worktree defaults to its own ./data.
# DATA_DIR=

# Label of this copy. "prod" names the macOS app «What To Do», anything else «What To Do <Name>».
# INSTANCE_ENV_NAME=prod

# 1: the macOS app lives in the menu bar and leaves the Dock when its window is closed.
# MENU_BAR_ICON=0
