# Label of this copy: "prod" names the macOS app «What To Do», anything else «What To Do <Name>».
INSTANCE_ENV_NAME=dev
# The address is http://127.0.0.1:<PORT>. Prod uses 18765.
PORT=18766
# Folder for the database and images. Empty means ~/Library/Application Support/where-to-go,
# the folder of the real data: leave it empty only in the prod copy.
DATA_DIR=./data
# 1: the macOS app lives in the menu bar and leaves the Dock when its window is closed.
MENU_BAR_ICON=0
