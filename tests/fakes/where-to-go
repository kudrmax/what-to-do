"""A stand-in for the app's server: answers its version, starts a child that starts a grandchild, as the
server starts Claude's processes, and keeps a record of itself as the real one does. Named like the app's
command, so a server without a record is still known by its command line."""

import argparse
import json
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

from where_to_go.launcher.paths import ProjectPaths
from where_to_go.launcher.records import ServerRecords
from where_to_go.launcher.spec import ServerSpec

VERSION = "9.9.9"
LONG_S = 600
GRANDPARENT = (
    "import subprocess, sys, time\n"
    f"subprocess.Popen([sys.executable, '-c', 'import time; time.sleep({LONG_S})'])\n"
    f"time.sleep({LONG_S})\n"
)


class Version(BaseHTTPRequestHandler):
    def do_GET(self) -> None:  # noqa: N802 — the name http.server calls
        body = json.dumps({"version": VERSION}).encode()
        self.send_response(200 if self.path in ("/version", "/api/version") else 404)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:  # noqa: A002
        pass


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--data", type=Path, required=True)
    parser.add_argument("--ui", type=Path)
    parser.add_argument("--no-ui", action="store_true")
    parser.add_argument("--instance", default="test")
    parser.add_argument("--no-record", action="store_true")
    arguments, _ = parser.parse_known_args([argument for argument in sys.argv[1:] if argument != "serve"])
    if (arguments.data / "fail").exists():
        print("boom on start", flush=True)
        sys.exit(1)
    arguments.data.mkdir(parents=True, exist_ok=True)
    child = subprocess.Popen([sys.executable, "-c", GRANDPARENT])
    server = ThreadingHTTPServer(("127.0.0.1", arguments.port), Version)
    if not arguments.no_record:
        spec = ServerSpec(arguments.port, arguments.data.resolve(), arguments.ui, arguments.instance)
        ServerRecords(ProjectPaths(Path.cwd())).register(spec, VERSION)
    (arguments.data / f"child-{arguments.port}.pid").write_text(str(child.pid))
    server.serve_forever()


if __name__ == "__main__":
    main()
