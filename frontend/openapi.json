  "/events": {
   "get": {
    "tags": [
     "events"
    ],
    "summary": "Feed",
    "description": "The feed: cards laid out on days, sorted by day, then time; unknown time and multiday events go last in a day.",
    "operationId": "feed_events_get",
    "parameters": [
     {
      "name": "start",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "description": "First day; default: today in the city's time zone, or the earliest event when only end is given",
       "title": "Start"
      },
      "description": "First day; default: today in the city's time zone, or the earliest event when only end is given"
     },
     {
      "name": "end",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "description": "Last day, inclusive; default: as far as the city has dated events",
       "title": "End"
      },
      "description": "Last day, inclusive; default: as far as the city has dated events"
     },
     {
      "name": "tags",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Any of these tags; repeat the parameter for several",
       "default": [],
       "title": "Tags"
      },
      "description": "Any of these tags; repeat the parameter for several"
     },
     {
      "name": "sources",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "integer"
       },
       "description": "Cards that have a post from any of these sources",
       "default": [],
       "title": "Sources"
      },
      "description": "Cards that have a post from any of these sources"
     },
     {
      "name": "plans",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "$ref": "#/components/schemas/PlanFilter"
       },
       "description": "Only cards with these plans; none = not marked yet. Default: all",
       "default": [],
       "title": "Plans"
      },
      "description": "Only cards with these plans; none = not marked yet. Default: all"
     },
     {
      "name": "only_timed",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "description": "Only events with a known date and time",
       "default": false,
       "title": "Only Timed"
      },
      "description": "Only events with a known date and time"
     },
     {
      "name": "hide_multiday",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "description": "Hide exhibitions, festivals and other multiday events",
       "default": false,
       "title": "Hide Multiday"
      },
      "description": "Hide exhibitions, festivals and other multiday events"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Occurrence"
         },
         "title": "Response Feed Events Get"
        }
