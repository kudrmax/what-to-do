 "components": {
  "schemas": {
   "CityIn": {
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "title": "Name",
      "examples": [
       "Белград"
      ]
     },
     "timezone": {
      "type": "string",
      "title": "Timezone",
      "examples": [
       "Europe/Belgrade"
      ]
     }
    },
    "type": "object",
    "required": [
     "name",
     "timezone"
    ],
    "title": "CityIn"
   },
   "CityOut": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "timezone": {
      "type": "string",
      "title": "Timezone",
      "description": "IANA time zone, e.g. Europe/Belgrade; «today» in the feed is counted in it"
     },
     "active": {
      "type": "boolean",
      "title": "Active",
      "description": "The feed, sources and refresh work with the active city only"
     }
    },
    "type": "object",
    "required": [
     "id",
     "name",
     "timezone",
     "active"
    ],
    "title": "CityOut"
   },
   "ConflictOut": {
    "properties": {
     "field": {
      "type": "string",
      "title": "Field",
      "description": "start_date or start_time"
     },
     "values": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Values",
      "description": "Every value the sources give; the card shows the first one",
      "examples": [
       [
        "19:00",
        "19:30"
       ]
      ]
     }
    },
    "type": "object",
    "required": [
     "field",
     "values"
    ],
    "title": "ConflictOut"
   },
   "EventDetailOut": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "kind": {
      "$ref": "#/components/schemas/EventKind",
      "description": "single: one date; multiday: start_date…end_date; recurring: repeats by `recurrence`"
     },
     "title": {
      "type": "string",
      "title": "Title",
      "description": "Claude's own title in the description language"
     },
     "original_title": {
      "type": "string",
      "title": "Original Title",
      "description": "The title as the organizer or the channel wrote it"
     },
     "description": {
      "type": "string",
      "title": "Description",
      "description": "Claude's summary in the author's manner; the main element of a card"
     },
     "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date",
      "description": "For recurring events: the first occurrence"
     },
     "end_date": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "End Date",
      "description": "multiday only"
     },
     "start_time": {
      "anyOf": [
       {
        "type": "string",
        "format": "time"
